# --- LLM ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL_NAME=gpt-4o-mini

# --- Search / Scrape ---
TAVILY_API_KEY=tvly-...
# ScrapeGraphAI can run on the same OPENAI_API_KEY, no separate key needed.

# --- App ---
# Set to "true" to run the whole pipeline on realistic mock data
# (no API keys required) — useful for demos and CI.
DEMO_MODE=false
